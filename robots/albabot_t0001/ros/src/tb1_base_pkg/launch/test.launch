<launch>
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
        <param name="video_device" value="/dev/video6" />
        <param name="image_width" value="160" />
        <param name="image_height" value="120" />
        <param name="pixel_format" value="uyvy" />
        <!--param name="camera_frame_id" value="usb_cam" />
        <param name="camera_info_url" value="file:///home/swpark/.ros/camera_info/logitech_c920_camera.yaml" />
        <param name="camera_info_url" value="file://$(find ad1_navigation)/camera_info/logitech_c920_camera.yaml" /-->
        <param name="io_method" value="userptr"/>
    </node>

    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <param name="autosize" value="true" />
    </node>

<include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch" >
    <arg name="port" value="9090"/>
</include>

    <node pkg="web_video_server" type="web_video_server" name="web_video_server">
        <rosparam>
            width: 160
            height: 120
            quality: 10
            default_transport: compressed
        </rosparam>
    </node>

    <node pkg="image_transport" type="republish" name="republish" args="raw in:=usb_cam/image_raw compressed out:=thermal/image">
    </node>

</launch>
