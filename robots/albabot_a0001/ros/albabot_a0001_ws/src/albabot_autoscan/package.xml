<?xml version="1.0"?>
<package format="2">
  <name>albabot_autoscan</name>
  <version>0.1.0</version>
  <description>
    라이다 없이 RealSense D435로 저속 자율 공간스캔.
    RGB-D SLAM(RTAB-Map) 매핑 + 카메라/초음파 기반 안전정지 + 반응형 탐색.
  </description>
  <maintainer email="rndresearchfoundation@gmail.com">rnd</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>albabot_msgs</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rtabmap_ros</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>rosserial_python</exec_depend>
  <exec_depend>tf</exec_depend>
</package>
